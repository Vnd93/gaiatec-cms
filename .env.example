# Frontend (public values bundled by Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key
VITE_CMS_ENVIRONMENT=local
VITE_EV2_SYSTEM_ASSURANCE_CANDIDATE=false

# Supabase Management API / CLI (private; never use the VITE_ prefix)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-personal-access-token
# Optional: only for trusted local/server-side data administration
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Edge Functions (private; configure with `supabase secrets set`)
# Exact origins only; never combine production and staging trust in a deployed environment.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Staging: ALLOWED_ORIGINS=https://gaiatec-cms-staging.pages.dev,https://ev2-g17-canary.gaiatec-cms-staging.pages.dev,https://ev2-g12-canary.gaiatec-cms-staging.pages.dev,https://ev2-g16-csp-canary.gaiatec-cms-staging.pages.dev,https://ev2-g12-rollback-compat.gaiatec-cms-staging.pages.dev
# Production: ALLOWED_ORIGINS=https://gaiatecsistemas.com.br,https://www.gaiatecsistemas.com.br
PUBLIC_SITE_ORIGIN=https://gaiatecsistemas.com.br
RATE_LIMIT_SALT=generate-a-long-random-value
EVIDENCE_SALT=generate-an-independent-long-random-value
TURNSTILE_SECRET_KEY=your-private-turnstile-secret
TURNSTILE_ALLOWED_HOSTNAMES=127.0.0.1,localhost
# Staging: TURNSTILE_ALLOWED_HOSTNAMES=gaiatec-cms-staging.pages.dev,ev2-g17-canary.gaiatec-cms-staging.pages.dev,ev2-g12-canary.gaiatec-cms-staging.pages.dev,ev2-g16-csp-canary.gaiatec-cms-staging.pages.dev,ev2-g12-rollback-compat.gaiatec-cms-staging.pages.dev
# Production: TURNSTILE_ALLOWED_HOSTNAMES=gaiatecsistemas.com.br,www.gaiatecsistemas.com.br
CONTACT_CAPTCHA_ALWAYS=false
CONTACT_NOTIFY_EMAIL=contact-owner@example.com
CONTACT_FROM_EMAIL=GAIATEC Site <no-reply@example.com>
RESEND_API_KEY=your-private-resend-key
CMS_ENVIRONMENT=local

# Cloudflare (Wrangler OAuth is preferred locally; API token is useful for CI)
CLOUDFLARE_API_TOKEN=your-scoped-api-token
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_PAGES_PROJECT_NAME=your-pages-project-name

# Mandatory GitHub production-environment corporate MFA canary over the exact
# sealed Cloudflare preview. Keep identity and credentials as protected GitHub
# environment secrets; they are never written to evidence.
PRODUCTION_AUTHENTICATED_PREFLIGHT_REQUIRED=true
PRODUCTION_AUTH_CANARY_EMAIL_DOMAIN=gaiatecsistemas.com.br
PRODUCTION_AUTH_CANARY_EMAIL=store-only-as-a-github-environment-secret
PRODUCTION_AUTH_CANARY_PASSWORD=store-only-as-a-github-environment-secret
PRODUCTION_AUTH_CANARY_TOTP_SECRET=store-only-as-a-github-environment-secret
# Must normalize to the same address as PRODUCTION_AUTH_CANARY_EMAIL. It is
# passed separately so the provisioning boundary can fail closed on mismatch.
PRODUCTION_OPERATOR_EMAIL=store-only-as-a-github-environment-secret
