# Frontend (public values bundled by Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_TURNSTILE_SITE_KEY=your-public-turnstile-site-key
VITE_CMS_ENVIRONMENT=local
VITE_EV2_SYSTEM_ASSURANCE_CANDIDATE=false

# Supabase Management API / CLI (private; never use the VITE_ prefix)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-personal-access-token
# Optional: only for trusted local/server-side data administration
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Edge Functions (private; configure with `supabase secrets set`)
ALLOWED_ORIGINS=https://gaiatecsistemas.com.br,https://gaiatec-cms-staging.pages.dev
PUBLIC_SITE_ORIGIN=https://gaiatecsistemas.com.br
RATE_LIMIT_SALT=generate-a-long-random-value
EVIDENCE_SALT=generate-an-independent-long-random-value
TURNSTILE_SECRET_KEY=your-private-turnstile-secret
CONTACT_CAPTCHA_ALWAYS=false
CONTACT_NOTIFY_EMAIL=contact-owner@example.com
CONTACT_FROM_EMAIL=GAIATEC Site <no-reply@example.com>
RESEND_API_KEY=your-private-resend-key
CMS_ENVIRONMENT=local

# Cloudflare (Wrangler OAuth is preferred locally; API token is useful for CI)
CLOUDFLARE_API_TOKEN=your-scoped-api-token
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_PAGES_PROJECT_NAME=your-pages-project-name
