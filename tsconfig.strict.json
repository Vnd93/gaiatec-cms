{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noCheck": false,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/shared/**/*.ts",
    "tests/setup.ts",
    "tests/unit/**/*.ts",
    "tests/contracts/**/*.ts",
    "tests/components/**/*.tsx",
    "tests/e2e/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
