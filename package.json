{
  "name": "@gaiatec/site-publico",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/prepare-cloudflare-worker.mjs",
    "build:full": "node scripts/generate-responsive-images.mjs && vite build",
    "build:staging": "npm run build && node scripts/prepare-staging-headers.mjs",
    "artifact:manifest": "node scripts/phase2/create-release-manifest.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run test:phase3 && npm run test:phase4 && npm run test:phase5 && npm run build",
    "cf:whoami": "wrangler whoami",
    "cf:projects": "wrangler pages project list",
    "deploy:preview": "npm run build:staging && wrangler pages deploy dist --project-name gaiatec-cms-staging --branch preview",
    "deploy:staging": "npm run build:staging && wrangler pages deploy dist --project-name gaiatec-cms-staging --branch Remodelagem",
    "deploy:production": "npm run build && wrangler pages deploy dist --project-name gaiatec-website --branch main",
    "format": "prettier --write eslint.config.js playwright.config.ts tsconfig.json tsconfig.strict.json vitest.config.ts .github/workflows docs/fase-2 docs/fase-3 docs/fase-4 docs/fase-5 src/admin src/public src/shared tests scripts/phase2 scripts/phase3 scripts/phase4 scripts/phase5",
    "format:check": "prettier --check eslint.config.js playwright.config.ts tsconfig.json tsconfig.strict.json vitest.config.ts .github/workflows docs/fase-2 docs/fase-3 docs/fase-4 docs/fase-5 src/admin src/public src/shared tests scripts/phase2 scripts/phase3 scripts/phase4 scripts/phase5",
    "lint": "eslint src tests scripts/phase2 scripts/phase3 vite.config.ts vitest.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.strict.json && tsc --noEmit --noCheck -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/contracts tests/components",
    "test:integration": "node --test scripts/phase2/*.test.mjs",
    "test:phase3": "node --test scripts/phase3/*.test.mjs",
    "test:phase4": "node --test scripts/phase4/*.test.mjs",
    "test:phase5": "node --test scripts/phase5/*.test.mjs",
    "test:rls": "supabase test db",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "validate:local": "node scripts/phase2/validate-local.mjs",
    "validate:local:clean": "npm ci && npm run validate:local",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173",
    "smoke:http": "node scripts/phase2/http-smoke.mjs",
    "test:phase1": "node --test scripts/phase1/*.test.mjs",
    "dev": "vite",
    "responsive-images": "node scripts/generate-responsive-images.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@react-pdf/renderer": "^4.3.1",
    "@supabase/supabase-js": "^2.101.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "react-day-picker": "8.10.1",
    "react-hook-form": "7.55.0",
    "react-resizable-panels": "2.1.7",
    "react-responsive-masonry": "2.7.1",
    "react-router": "7.18.2",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "6.4.3",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "sharp": "0.35.4"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.12": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260826.1": true
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  }
